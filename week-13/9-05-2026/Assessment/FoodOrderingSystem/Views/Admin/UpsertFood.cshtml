@model FoodItem
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Food" : "Edit Food";
}

<section class="page-title"><div class="container"><h1>@ViewData["Title"]</h1></div></section>
<section class="container py-4">
    <form method="post" enctype="multipart/form-data" class="panel">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ImageUrl" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
            <div class="col-md-3"><label asp-for="PreparationMinutes" class="form-label"></label><input asp-for="PreparationMinutes" class="form-control" /><span asp-validation-for="PreparationMinutes" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select></div>
            <div class="col-md-6"><label class="form-label">Food Image</label><input type="file" name="image" class="form-control" accept="image/*" /></div>
            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
            <div class="col-md-3 form-check ms-2"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label"></label></div>
            <div class="col-md-3 form-check"><input asp-for="IsVegetarian" class="form-check-input" /><label asp-for="IsVegetarian" class="form-check-label"></label></div>
        </div>
        <button class="btn btn-primary mt-4" type="submit">Save</button>
        <a class="btn btn-outline-dark mt-4" asp-action="FoodItems">Cancel</a>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
