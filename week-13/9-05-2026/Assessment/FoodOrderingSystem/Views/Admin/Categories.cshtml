@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<section class="page-title"><div class="container"><h1>Categories</h1></div></section>
<section class="container py-4">
    <form asp-action="SaveCategory" method="post" class="panel mb-4">
        <div class="row g-3">
            <div class="col-md-4"><input name="Name" class="form-control" placeholder="Category name" required /></div>
            <div class="col-md-6"><input name="Description" class="form-control" placeholder="Description" /></div>
            <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Add</button></div>
        </div>
    </form>
    <div class="row g-3">
        @foreach (var category in Model)
        {
            <div class="col-md-6">
                <div class="category-row align-items-stretch">
                    <form asp-action="SaveCategory" method="post" class="flex-grow-1">
                        <input type="hidden" name="Id" value="@category.Id" />
                        <input name="Name" value="@category.Name" class="form-control mb-2" required />
                        <input name="Description" value="@category.Description" class="form-control" />
                        <button class="btn btn-outline-dark btn-sm mt-2" type="submit">Update</button>
                    </form>
                    <form asp-action="DeleteCategory" method="post" class="align-self-start">
                        <input type="hidden" name="id" value="@category.Id" />
                        <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>
