@model IEnumerable<FoodItem>
@{
    ViewData["Title"] = "Manage Food";
}

<section class="page-title">
    <div class="container d-flex justify-content-between align-items-center">
        <h1>Food Items</h1>
        <a class="btn btn-primary" asp-action="UpsertFood">Add Food Item</a>
    </div>
</section>
<section class="container py-4">
    <div class="table-responsive panel">
        <table class="table align-middle">
            <thead><tr><th>Food</th><th>Category</th><th>Price</th><th>Available</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Name</strong><br /><span class="text-muted">@item.Description</span></td>
                    <td>@item.Category?.Name</td>
                    <td>Rs. @item.Price</td>
                    <td>@(item.IsAvailable ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-outline-dark btn-sm" asp-action="UpsertFood" asp-route-id="@item.Id">Edit</a>
                        <form asp-action="DeleteFood" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
