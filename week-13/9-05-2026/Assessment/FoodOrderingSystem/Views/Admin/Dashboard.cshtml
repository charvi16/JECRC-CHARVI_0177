@model IEnumerable<Order>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="page-title"><div class="container"><h1>Admin Dashboard</h1></div></section>
<section class="container py-4">
    <div class="row g-4 mb-4">
        <div class="col-md-4"><div class="metric"><span>Food Items</span><strong>@ViewBag.FoodCount</strong></div></div>
        <div class="col-md-4"><div class="metric"><span>Active Orders</span><strong>@ViewBag.PendingOrders</strong></div></div>
        <div class="col-md-4"><div class="metric"><span>Revenue</span><strong>Rs. @ViewBag.Revenue</strong></div></div>
    </div>
    <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Recent Orders</h2>
            <a class="btn btn-outline-dark btn-sm" asp-action="Orders">Manage Orders</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr><td>#@order.Id</td><td>@order.CustomerName</td><td>@order.Status</td><td>Rs. @order.Total</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
